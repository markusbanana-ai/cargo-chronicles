      "hints": [
        {
          "if": "Ships are attacked or seized in an area",
          "then": "War-risk premiums for that area rise quickly. Some owners avoid it, which lengthens routes and moves freight rates."
        },
        {
          "if": "A ship has a fire, grounding or collision",
          "then": "Ask which cover pays: damage to the ship is hull insurance; pollution, crew and wreck removal is P&I; costs to save the whole voyage may be general average."
        },
        {
          "if": "P&I clubs announce renewals or general increases",
          "then": "Every member shipowner pays more from 20 February. Increases follow claims trends and reinsurance costs."
        },
        {
          "if": "Ships or companies are sanctioned",
          "then": "Western insurers must withdraw cover. That pushes the ships into the shadow fleet, with weaker insurance and higher pollution risk for coastal states."
        }
      ]
    },
