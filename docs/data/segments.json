      "hints": [
        {
          "if": "Diesel prices or fuel taxes change",
          "then": "Fuel is often a quarter to a third of a truck's running cost. Hauliers without a diesel clause carry the full price risk until their contracts are renegotiated."
        },
        {
          "if": "Rules on driving time, cabotage or tachographs change",
          "then": "This decides how many hours a truck can earn money each day, and which foreign hauliers may compete for domestic jobs."
        },
        {
          "if": "A tunnel, road or ferry closes (for example Lærdalstunnelen)",
          "then": "Detours and night closures add hours and cost. Planners must rework driving times and delivery slots, and customers may see higher prices."
        },
        {
          "if": "Electric trucks and chargers are in the news",
          "then": "Check whether chargers sit at rest areas on your routes. Range and charging during the mandatory 45-minute break decide whether e-trucks work on long-haul."
        }
      ]
