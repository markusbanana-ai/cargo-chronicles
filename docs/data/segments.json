      "hints": [
        {
          "if": "A loan is priced at SOFR plus a margin",
          "then": "A lower margin means lenders see lower risk. Compare with earlier deals to see how bank sentiment has shifted."
        },
        {
          "if": "A ship is sold at a big gain",
          "then": "Secondhand values are high compared with book values, and owners are cashing in. Often a sign of a strong market—or of owners expecting it to peak."
        },
        {
          "if": "A company raises equity or issues a bond",
          "then": "Ask why: growth (paying for newbuildings) or repair (a weak balance sheet). The share price compared with NAV tells you which."
        },
        {
          "if": "A company books an impairment",
          "then": "It is a loss on paper, with no cash leaving the company, but it signals that management expects lower earnings or ship values."
        }
      ]
