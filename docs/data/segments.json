        {
          "if": "New discoveries or tiebacks are planned on the Norwegian shelf",
          "then": "More activity at supply bases such as CCB Ågotnes and Mongstad, and more trucking of equipment to and from the bases."
        },
        {
          "if": "Offshore wind contracts are signed or cancelled",
          "then": "Drives demand for service vessels (CSOVs), cable-lay ships and project cargo logistics. Delays ripple through the whole chain."
        },
        {
          "if": "Decommissioning campaigns are awarded",
          "then": "Steady work for subsea vessels and heavy lift, and large flows of steel and equipment to onshore recycling yards."
        }
